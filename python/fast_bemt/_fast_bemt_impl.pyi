from __future__ import annotations
import enum
from typing import Sequence, Tuple, overload
import numpy as np
from numpy.typing import NDArray


class WakeModel(enum.Enum):
    GlauertPittPeters = 0
    GlauertAnnulus = 1
    LocalElement = 2


GlauertPittPeters: WakeModel
GlauertAnnulus: WakeModel
LocalElement: WakeModel


class BSplineCurve:
    @overload
    def __init__(
        self,
        ctrl_pts_2d: NDArray[np.float64],
        degree: int = 3,
    ) -> None: ...

    @overload
    def __init__(
        self,
        ctrl_r_norm: NDArray[np.float64],
        ctrl_vals: NDArray[np.float64],
        degree: int = 3,
    ) -> None: ...

    @staticmethod
    def from_1d_values(
        ctrl_vals: NDArray[np.float64],
        degree: int = 3,
        r_norm_min: float = 0.0,
        r_norm_max: float = 1.0,
    ) -> BSplineCurve: ...

    def eval_u(self, u: float) -> Tuple[float, float]: ...
    def eval_u_batch(self, u_vec: NDArray[np.float64]) -> Tuple[NDArray[np.float64], NDArray[np.float64]]: ...
    def sample(self, n_points: int = 200) -> Tuple[NDArray[np.float64], NDArray[np.float64]]: ...

    @overload
    def invert_r_norm(self, target_r_norm: float) -> float: ...
    @overload
    def invert_r_norm(self, target_r_norm: NDArray[np.float64]) -> NDArray[np.float64]: ...

    def eval_at_r_norm(self, target_r_norm: float) -> float: ...
    def eval_batch(self, target_r_norm: NDArray[np.float64]) -> NDArray[np.float64]: ...

    @overload
    def __call__(self, target_r_norm: float) -> float: ...
    @overload
    def __call__(self, target_r_norm: NDArray[np.float64]) -> NDArray[np.float64]: ...

    def basis_matrix(self, target_r_norm: NDArray[np.float64]) -> NDArray[np.float64]: ...

    @overload
    def slope_dy_dx(self, target_r_norm: float) -> float: ...
    @overload
    def slope_dy_dx(self, target_r_norm: NDArray[np.float64]) -> NDArray[np.float64]: ...

    @property
    def degree(self) -> int: ...
    @property
    def num_ctrl_points(self) -> int: ...
    @property
    def knots(self) -> NDArray[np.float64]: ...
    @property
    def ctrl_r_norm(self) -> NDArray[np.float64]: ...
    @property
    def ctrl_vals(self) -> NDArray[np.float64]: ...
    @property
    def ctrl_points(self) -> NDArray[np.float64]: ...


class Airfoil3D:
    def __init__(
        self,
        alpha_grid: NDArray[np.float64],
        re_grid: NDArray[np.float64],
        ma_grid: NDArray[np.float64],
        cl_table: NDArray[np.float64],
        cd_table: NDArray[np.float64],
        aspect_ratio: float = 10.0,
        enable_extrapolation: bool = True,
    ) -> None: ...

    @staticmethod
    def from_1d_polar(
        alpha_grid: NDArray[np.float64],
        cl_1d: NDArray[np.float64],
        cd_1d: NDArray[np.float64],
        ref_re: float = 1e6,
        aspect_ratio: float = 10.0,
        enable_extrapolation: bool = True,
    ) -> Airfoil3D: ...

    @staticmethod
    def interpolate_section(
        af0: Airfoil3D,
        af1: Airfoil3D,
        weight: float,
    ) -> Airfoil3D: ...

    @staticmethod
    def interpolate_spanwise_sections(
        section_r_norm: NDArray[np.float64],
        section_airfoils: Sequence[Airfoil3D],
        target_r_norm: NDArray[np.float64],
    ) -> list[Airfoil3D]: ...

    def eval(self, alpha: float, re: float = 1e6, ma: float = 0.0) -> Tuple[float, float]: ...
    def eval_batch(
        self,
        alpha_vec: NDArray[np.float64],
        re_vec: NDArray[np.float64],
        ma_vec: NDArray[np.float64],
    ) -> Tuple[NDArray[np.float64], NDArray[np.float64]]: ...

    @property
    def zero_lift_alpha(self) -> float: ...
    @property
    def linear_lift_slope(self) -> float: ...
    @property
    def alpha_min(self) -> float: ...
    @property
    def alpha_max(self) -> float: ...


class RotorGeometry:
    num_blades: int
    radius: float
    hub_radius: float
    spin_dir: int
    n_radial: int
    bspline_degree: int
    r: NDArray[np.float64]
    dr: NDArray[np.float64]
    chord_curve: BSplineCurve
    twist_curve: BSplineCurve
    chord_ctrl_r_norm: NDArray[np.float64]
    chord_ctrl: NDArray[np.float64]
    twist_ctrl_r_norm: NDArray[np.float64]
    twist_ctrl: NDArray[np.float64]
    section_r_norm: NDArray[np.float64]
    section_airfoils: list[Airfoil3D]
    airfoils: list[Airfoil3D]

    @overload
    def __init__(
        self,
        num_blades: int,
        radius: float,
        hub_radius: float,
        n_radial: int,
        chord_curve: BSplineCurve,
        twist_curve: BSplineCurve,
        airfoils: Sequence[Airfoil3D],
        section_r_norm: Sequence[float] | NDArray[np.float64] = ...,
        spin_dir: int = 1,
    ) -> None: ...

    @overload
    def __init__(
        self,
        num_blades: int,
        radius: float,
        hub_radius: float,
        r: NDArray[np.float64],
        chord_curve: BSplineCurve,
        twist_curve: BSplineCurve,
        airfoils: Sequence[Airfoil3D],
        section_r_norm: Sequence[float] | NDArray[np.float64] = ...,
        spin_dir: int = 1,
        dr: NDArray[np.float64] = ...,
    ) -> None: ...

    @property
    def chord(self) -> NDArray[np.float64]: ...
    @property
    def twist(self) -> NDArray[np.float64]: ...
    @property
    def chord_basis(self) -> NDArray[np.float64]: ...
    @property
    def twist_basis(self) -> NDArray[np.float64]: ...
    @property
    def chord_knots(self) -> NDArray[np.float64]: ...
    @property
    def twist_knots(self) -> NDArray[np.float64]: ...
    @property
    def dchord_dr_norm(self) -> NDArray[np.float64]: ...
    @property
    def dtwist_dr_norm(self) -> NDArray[np.float64]: ...
    def validate_and_finalize(self) -> None: ...


class OperatingCondition:
    vx: float
    vy: float
    vz: float
    omega: float
    pitch_0: float
    pitch_1c: float
    pitch_1s: float
    rho: float
    mu: float
    a_sound: float

    def __init__(
        self,
        vx: float = 0.0,
        vy: float = 0.0,
        vz: float = 0.0,
        omega: float = 100.0,
        pitch_0: float = 0.0,
        pitch_1c: float = 0.0,
        pitch_1s: float = 0.0,
        rho: float = 1.225,
        mu: float = 1.7894e-5,
        a_sound: float = 340.29,
    ) -> None: ...

    @staticmethod
    def from_freestream(
        v_inf: float,
        alpha_disk_rad: float,
        omega_rad_s: float,
        pitch_0_rad: float = 0.0,
        pitch_1c_rad: float = 0.0,
        pitch_1s_rad: float = 0.0,
        beta_rad: float = 0.0,
        rho: float = 1.225,
        mu: float = 1.7894e-5,
        a_sound: float = 340.29,
    ) -> OperatingCondition: ...


class SolverConfig:
    n_azimuth: int
    wake_model: WakeModel
    enable_tip_loss: bool
    enable_vrs_correction: bool
    enable_stall_delay: bool
    enable_tangential_induction: bool
    max_newton_iters: int
    max_brent_iters: int
    max_wake_iters: int
    tol: float
    newton_max_step: float

    def __init__(
        self,
        n_azimuth: int = 36,
        wake_model: WakeModel = WakeModel.GlauertPittPeters,
        enable_tip_loss: bool = True,
        enable_vrs_correction: bool = True,
        enable_stall_delay: bool = True,
        enable_tangential_induction: bool = True,
        max_newton_iters: int = 15,
        max_brent_iters: int = 60,
        max_wake_iters: int = 4,
        tol: float = 1e-10,
        newton_max_step: float = 0.25,
    ) -> None: ...


